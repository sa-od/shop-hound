  "components": [
    {
      "name": "Price Ticket on Rail",
      "kind": "custom",
      "refersTo": "ticket",
      "description": "A price change as a shelf-edge ticket; yellow sticker on a cut, carbon on a rise. Always hangs on the grey rail.",
      "html": "<div class=\"ds-rail\"><a class=\"ds-ticket\" href=\"#\"><span class=\"ds-sticker ds-sticker-cut\">-60%</span><span class=\"ds-ticket-title\">No Regifts - Large</span><span class=\"ds-ticket-store\">goodr.com</span><span class=\"ds-ticket-was\">was <s>5.00</s></span><span class=\"ds-ticket-price ds-cut\">2.00</span></a><a class=\"ds-ticket\" href=\"#\"><span class=\"ds-sticker ds-sticker-rise\">+8%</span><span class=\"ds-ticket-title\">Trail Mix 500g</span><span class=\"ds-ticket-store\">store-two.com</span><span class=\"ds-ticket-was\">was <s>12.00</s></span><span class=\"ds-ticket-price\">12.96</span></a></div>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-rail{display:flex;gap:12px;flex-wrap:wrap;width:fit-content;background:var(--color-rail);border-radius:8px;padding:16px 14px 14px;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-ticket{position:relative;display:flex;flex-direction:column;width:188px;background:var(--color-stock);color:var(--color-ink);text-decoration:none;border-radius:4px;padding:12px 12px 10px;box-shadow:0 1px 2px rgb(17 17 17 / 0.12),0 1px 0 #b9bdc4;transition:transform 150ms;}.ds-ticket:hover{transform:translateY(-2px);}.ds-ticket:hover .ds-ticket-title{text-decoration:underline;}.ds-ticket:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}.ds-sticker{position:absolute;right:-6px;top:-8px;transform:rotate(4deg);border-radius:3px;padding:4px 8px;font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-weight:800;font-size:16px;line-height:1;}.ds-sticker-cut{background:var(--color-sticker);color:var(--color-ink);}.ds-sticker-rise{background:var(--color-ink);color:#fff;}.ds-ticket-title{min-height:34px;padding-right:32px;font-size:13px;font-weight:600;line-height:1.3;}.ds-ticket-store{margin-top:2px;font-size:11px;color:var(--color-ink-3);}.ds-ticket-was{margin-top:10px;font-size:12px;color:var(--color-ink-3);}.ds-ticket-price{font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-weight:800;font-size:38px;line-height:1;color:var(--color-ink);}.ds-ticket-price.ds-cut{color:var(--color-cut);}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Carbon action button, used to submit an analysis.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg>Add store</button>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;border:0;border-radius:6px;background:var(--color-ink);color:#fff;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:14px;font-weight:600;cursor:pointer;transition:background-color 150ms;}.ds-btn-primary:hover{background:#2a2c30;}.ds-btn-primary:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}.ds-btn-primary:disabled{background:#9a9da4;cursor:not-allowed;}"
    },
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "Sticky carbon bar: wordmark, two tabs with a yellow active underline, run status and the Add store button.",
      "html": "<header class=\"ds-bar\"><span class=\"ds-bar-brand\">Growth Briefs</span><nav class=\"ds-bar-nav\"><a href=\"#\" class=\"ds-tab ds-tab-active\" aria-current=\"page\">This week</a><a href=\"#\" class=\"ds-tab\">Briefs</a></nav><span class=\"ds-bar-right\"><span class=\"ds-bar-status\">Last brief Nov 13</span><button class=\"ds-btn-bar\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg>Add store</button></span></header>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-bar{display:flex;align-items:center;gap:40px;height:56px;padding:0 32px;background:var(--color-ink);color:#fff;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-bar-brand{font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-weight:800;font-size:22px;line-height:1;letter-spacing:-0.025em;}.ds-bar-nav{display:flex;align-self:stretch;}.ds-tab{display:flex;align-items:center;padding:3px 14px 0;border-bottom:3px solid transparent;color:#a8abb2;font-size:14px;text-decoration:none;transition:color 150ms;}.ds-tab:hover{color:#fff;}.ds-tab-active{border-bottom-color:var(--color-sticker);color:#fff;font-weight:600;}.ds-tab:focus-visible{outline:2px solid #fff;outline-offset:-4px;}.ds-bar-right{margin-left:auto;display:flex;align-items:center;gap:12px;}.ds-bar-status{font-size:13px;color:#a8abb2;}.ds-btn-bar{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:0;border-radius:6px;background:#fff;color:var(--color-ink);font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:13px;font-weight:600;cursor:pointer;transition:background-color 150ms;}.ds-btn-bar:hover{background:var(--color-sticker);}.ds-btn-bar:focus-visible{outline:2px solid #fff;outline-offset:2px;}"
    },
    {
      "name": "Domain Input",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Text field for one store website, with help line that turns red on error.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Competitor stores to analyse</span><input class=\"ds-input\" placeholder=\"store-one.com, store-two.com\"><span class=\"ds-field-help\">Up to 6 stores, separated by commas.</span></label>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-field{display:flex;flex-direction:column;gap:8px;max-width:420px;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--color-ink);}.ds-field-label{font-size:14px;font-weight:600;}.ds-input{height:40px;padding:0 12px;border:1px solid #c4c8cf;border-radius:6px;background:var(--color-stock);color:var(--color-ink);font:inherit;font-size:14px;outline:none;transition:border-color 150ms;}.ds-input::placeholder{color:var(--color-ink-3);}.ds-input:hover{border-color:var(--color-ink-3);}.ds-input:focus{border-color:var(--color-ink);}.ds-input:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}.ds-input[aria-invalid]{border-color:var(--color-cut);}.ds-field-help{font-size:13px;color:var(--color-ink-3);}"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "tag-verified",
      "description": "Read-only pill labels for per-store and audit status.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-tag-ok\">Verified</span><span class=\"ds-tag ds-tag-info\">Baseline</span><span class=\"ds-tag ds-tag-warn\">Unverified</span></div>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-tags{display:flex;gap:8px;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-tag{display:inline-block;white-space:nowrap;border-radius:9999px;padding:4px 10px;font-size:11px;font-weight:600;line-height:1;}.ds-tag-ok{background:var(--color-ok-soft);color:var(--color-ok);}.ds-tag-info{background:var(--color-info-soft);color:var(--color-info);}.ds-tag-warn{background:var(--color-warn-soft);color:var(--color-warn);}"
    },
    {
      "name": "What to Do Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat card-stock container with a 1px edge; shown with numbered yellow action markers.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">What to do</h2><ol class=\"ds-actions\"><li><span class=\"ds-marker\">1</span><span><strong>Monitor goodr.com</strong>: new items and significant price cuts.</span></li><li><span class=\"ds-marker\">2</span><span><strong>Review your pricing</strong> on the overlapping sunglasses range.</span></li></ol></section>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-card{max-width:380px;background:var(--color-stock);border:1px solid var(--color-edge);border-radius:8px;padding:24px;color:var(--color-ink);font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;}.ds-card-title{margin:0;font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-weight:700;font-size:20px;}.ds-actions{list-style:none;margin:4px 0 0;padding:0;}.ds-actions li{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid #eceef1;font-size:14px;line-height:1.625;color:var(--color-ink-2);}.ds-actions li:last-child{border-bottom:0;padding-bottom:0;}.ds-actions strong{color:var(--color-ink);font-weight:600;}.ds-marker{display:grid;place-items:center;flex-shrink:0;width:24px;height:24px;border-radius:3px;background:var(--color-sticker);color:var(--color-ink);font-family:'Barlow Condensed','Barlow',ui-sans-serif,sans-serif;font-weight:800;font-size:15px;}"
    },
    {
      "name": "Movements Table",
      "kind": "custom",
      "refersTo": "card",
      "description": "One row per store; uppercase 11px column labels, right-aligned tabular figures, cut percentages in red.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Competitor</th><th class=\"ds-num\">Price changes</th><th class=\"ds-num\">Biggest move</th><th class=\"ds-num\">Status</th></tr></thead><tbody><tr><td><a href=\"#\">goodr.com</a><div class=\"ds-sub\">429 products · Shopify</div></td><td class=\"ds-num\">2</td><td class=\"ds-num ds-cut\">-60%</td><td class=\"ds-num\"><span class=\"ds-tag\">Verified</span></td></tr><tr><td><a href=\"#\">magicspoon.com</a><div class=\"ds-sub\">140 products · Shopify</div></td><td class=\"ds-num\">0</td><td class=\"ds-num ds-dash\">—</td><td class=\"ds-num\"><span class=\"ds-tag\">Verified</span></td></tr></tbody></table>",
      "css": ":host{--color-ink:#111111;--color-ink-2:#464a52;--color-ink-3:#62666f;--color-shelf:#f4f5f7;--color-stock:#ffffff;--color-edge:#dadde2;--color-rail:#d9dce0;--color-sticker:#ffd60a;--color-cut:#d11b23;--color-ok:#1d6f40;--color-ok-soft:#e4f3ea;--color-warn:#8a5100;--color-warn-soft:#fff3d1;--color-info:#23479e;--color-info-soft:#e7edfb;}.ds-table{width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background:var(--color-stock);border:1px solid var(--color-edge);border-radius:8px;font-family:'Barlow',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;font-size:14px;color:var(--color-ink);}.ds-table th{padding:10px 16px;border-bottom:1px solid var(--color-edge);text-align:left;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.04em;color:var(--color-ink-3);}.ds-table td{padding:12px 16px;border-bottom:1px solid #eceef1;}.ds-table tbody tr:last-child td{border-bottom:0;}.ds-table tbody tr:hover{background:#fafafb;}.ds-table .ds-num{text-align:right;}.ds-table a{color:inherit;font-weight:600;text-decoration:none;}.ds-table a:hover{text-decoration:underline;}.ds-sub{margin-top:2px;font-size:12px;color:var(--color-ink-3);}.ds-cut{color:var(--color-cut);font-weight:600;}.ds-dash{color:var(--color-ink-3);}.ds-tag{display:inline-block;border-radius:9999px;padding:4px 10px;font-size:11px;font-weight:600;line-height:1;background:var(--color-ok-soft);color:var(--color-ok);}"
    },
