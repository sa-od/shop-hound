output.txt
# macOS Finder metadata — created in any folder opened in Finder, read by
# nothing here. Bare pattern, so it matches at every depth.
.DS_Store
node_modules
dist
.mastra
.env.development
.env
*.db
*.db-*
# DuckDB (observability store) — *.db above does not match these, so ~11MB of
# stale local database was tracked and shipped in every deploy artifact.
*.duckdb
*.duckdb.wal
.netlify
.vercel
.env.production

# dashboard is a separate Vercel app
dashboard/node_modules
dashboard/.next
